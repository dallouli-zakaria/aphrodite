<style>
  :root {
    --brand: #c6842f;
    --brand-strong: #8f561b;
    --ink: #171717;
    --paper: #fbf7ef;
    --panel: #ffffff;
    --panel-soft: #f3eadc;
    --line: rgba(23, 23, 23, 0.12);
    --muted: #69645e;
    --danger: #b13f36;
    --good: #16845b;
    --shadow: 0 18px 50px rgba(30, 24, 18, 0.12);
  }

  * { box-sizing: border-box; }
  body {
    margin: 0;
    min-height: 100vh;
    background:
      radial-gradient(circle at 20% 20%, rgba(198, 132, 47, 0.16), transparent 34%),
      linear-gradient(135deg, #fbf7ef 0%, #f3eadc 100%);
    color: var(--ink);
    font-family: "Space Grotesk", sans-serif;
  }

  a { color: inherit; }

  .auth-page {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 32px 16px;
  }

  .back-link {
    position: fixed;
    top: 22px;
    left: 22px;
    color: var(--muted);
    text-decoration: none;
    font-weight: 700;
  }

  .auth-card {
    width: min(480px, 100%);
    padding: 34px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: color-mix(in srgb, var(--panel) 92%, transparent);
    box-shadow: var(--shadow);
    backdrop-filter: blur(18px);
  }

  .eyebrow {
    display: inline-flex;
    margin-bottom: 12px;
    color: var(--brand);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.78rem;
  }

  h1 {
    margin: 0;
    font-family: "Cormorant Garamond", serif;
    font-size: clamp(3rem, 8vw, 4.8rem);
    line-height: 0.95;
  }

  p {
    color: var(--muted);
    line-height: 1.65;
  }

  .auth-form {
    display: grid;
    gap: 13px;
    margin: 24px 0 12px;
  }

  label {
    display: grid;
    gap: 7px;
    color: var(--muted);
    font-weight: 700;
  }

  input {
    min-height: 46px;
    padding: 0 14px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--panel);
    color: var(--ink);
    font: inherit;
  }

  .button {
    min-height: 46px;
    padding: 0 16px;
    border: 1px solid var(--line);
    border-radius: 8px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font-weight: 800;
    text-decoration: none;
    font: inherit;
    cursor: pointer;
  }

  .primary {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }

  .ghost,
  .google {
    background: var(--panel);
    color: var(--ink);
  }

  .google {
    width: 100%;
  }

  .google span {
    width: 26px;
    height: 26px;
    display: grid;
    place-items: center;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
  }

  .notice {
    margin-top: 14px;
    padding: 12px;
    border-radius: 8px;
    background: var(--panel-soft);
    color: var(--ink);
  }

  .notice.error {
    background: color-mix(in srgb, var(--danger) 12%, var(--panel));
    color: var(--danger);
  }

  .notice.success {
    background: color-mix(in srgb, var(--good) 12%, var(--panel));
    color: var(--good);
  }

  .notice.warning {
    background: color-mix(in srgb, var(--brand) 16%, var(--panel));
    color: var(--brand-strong);
  }

  .switch-link {
    text-align: center;
    margin-bottom: 0;
  }

  .switch-link a {
    color: var(--brand-strong);
    font-weight: 800;
  }

  .account-box {
    padding: 16px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--panel-soft);
    display: grid;
    gap: 6px;
    margin: 22px 0;
  }

  .account-box span {
    color: var(--muted);
  }

  .orders-history {
    margin-top: 28px;
    display: grid;
    gap: 12px;
  }

  .orders-history h2 {
    margin: 0;
    font-size: 1.2rem;
  }
</style>
