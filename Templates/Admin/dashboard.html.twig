{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}AphroditeShop Admin{% endblock %}

{% block main %}
  <div class="admin-home">
    <section class="admin-hero">
      <h2>Bienvenue dans AphroditeShop.</h2>
      <p>
        Gere le catalogue, les categories, les commandes et les comptes depuis un tableau de bord adapte aux grands ecrans comme au mobile.
      </p>
    </section>

    <section class="admin-shortcuts" aria-label="Raccourcis admin">
      <a class="admin-shortcut" href="/admin/product">
        <strong>Produits</strong>
        <span>Prix, tailles, images et disponibilite.</span>
      </a>
      <a class="admin-shortcut" href="/admin/order">
        <strong>Commandes</strong>
        <span>Statut, livraison et suivi client.</span>
      </a>
      <a class="admin-shortcut" href="/admin/category">
        <strong>Categories</strong>
        <span>Hommes, femmes et pages principales.</span>
      </a>
      <a class="admin-shortcut" href="/admin/user">
        <strong>Comptes</strong>
        <span>Clients connectes et permissions.</span>
      </a>
    </section>
  </div>
{% endblock %}
