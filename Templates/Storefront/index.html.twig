      const freeShippingLimit = 599;
      const shippingCost = 29;
      const cartKey = "aphroditeshop-cart";
      const themeKey = "aphroditeshop-theme-v2";
      const langKey = "aphroditeshop-lang-v2";
  
      let lang = localStorage.getItem(langKey) || "fr";
      let themeChoice = localStorage.getItem(themeKey) || "light";
      let cart = loadCart();
      let activeFilter = "all";
      let homeSearch = "";
      let categorySearch = "";
      let currentCategory = "new-in";
      let toastTimer;
  
      const $ = (selector) => document.querySelector(selector);
      const $$ = (selector) => Array.from(document.querySelectorAll(selector));
  
      function t(key, values = {}) {
        let text = translations[lang][key] || translations.fr[key] || key;
        Object.entries(values).forEach(([name, value]) => {
          text = text.replace(`{${name}}`, value);
        });
        return text;
      }
  
      function localize(item) {
        return item[lang] || item.fr;
      }
  
      function formatMad(value) {
        return `${value.toLocaleString("fr-FR")} MAD`;
      }
  
      function loadCart() {
        try {
          const saved = JSON.parse(localStorage.getItem(cartKey) || "[]");
          return Array.isArray(saved) ? saved : [];
        } catch {
          return [];
        }
      }
  
      function saveCart() {
        localStorage.setItem(cartKey, JSON.stringify(cart));
      }
  
      function getProduct(id) {
        return products.find((product) => product.id === id);
      }
  
      function cartItems() {
        return cart
          .map((line) => {
            const product = getProduct(line.id);
            return product ? { ...product, qty: line.qty } : null;
          })
          .filter(Boolean);
      }
  
      function totals() {
        const subtotal = cartItems().reduce((sum, item) => sum + item.price * item.qty, 0);
        const delivery = subtotal === 0 || subtotal >= freeShippingLimit ? 0 : shippingCost;
        return { subtotal, delivery, total: subtotal + delivery };
      }
  
      function renderNav() {
        const navItems = categories.map((category) => ({
          href: `#/${category.slug}`,
          label: t(category.key),
          slug: category.slug
        }));
        navItems.push({ href: "#/checkout", label: t("checkout"), slug: "checkout" });
        $("#mainNav").innerHTML = navItems.map((item) => `<a href="${item.href}" data-nav="${item.slug}">${item.label}</a>`).join("");
      }
  
      function renderCategories() {
        $("#categoryGrid").innerHTML = categories
          .map((category) => {
            const copy = localize(category);
            return `
              <article class="category-card" style="background-image:url('${category.image}')">
                <div>
                  <strong>${copy.title}</strong>
                  <span>${copy.text}</span>
                </div>
                <a class="button" href="#/${category.slug}">${t("shop")}</a>
              </article>
            `;
          })
          .join("");
      }
  
      function productMatches(product, filter, search) {
        const copy = localize(product);
        const categoryMatch = filter === "all" || product.category === filter || (filter === "new-in" && product.category === "new-in");
        const haystack = `${copy.name} ${copy.brand} ${copy.desc} ${product.category}`.toLowerCase();
        return categoryMatch && haystack.includes(search.trim().toLowerCase());
      }
  
      function productCard(product) {
        const copy = localize(product);
        return `
          <article class="product-card">
            <div class="product-media">
              <img src="${product.image}" alt="${copy.name}" loading="lazy" />
              <span class="badge ${product.badgeClass || ""}">${product.badge}</span>
            </div>
            <div class="product-info">
              <div class="product-meta">
                <span>${copy.brand}</span>
                <span>${product.rating.toFixed(1)}/5</span>
              </div>
              <h3>${copy.name}</h3>
              <p>${copy.desc}</p>
              <div class="price-row">
                <span class="price">${formatMad(product.price)}</span>
                ${product.compareAt ? `<span class="old-price">${formatMad(product.compareAt)}</span>` : ""}
              </div>
              <div class="sizes">${product.sizes.map((size) => `<span class="size">${size}</span>`).join("")}</div>
              <div class="product-actions">
                <button class="button primary" type="button" data-add="${product.id}">${t("addToCart")}</button>
                <button class="button ghost" type="button" data-buy="${product.id}">${t("buyNow")}</button>
              </div>
            </div>
          </article>
        `;
      }
  
      function renderFilterChips() {
        const filters = [{ slug: "all", key: "shop" }, ...categories];
        $("#filterChips").innerHTML = filters
          .map((filter) => {
            const slug = filter.slug;
            const label = filter.key === "shop" ? t("shop") : t(filter.key);
            return `<button class="chip ${activeFilter === slug ? "is-active" : ""}" type="button" data-filter="${slug}">${label}</button>`;
          })
          .join("");
      }
  
      function renderHomeProducts() {
        const productsToShow = products.filter((product) => productMatches(product, activeFilter, homeSearch)).slice(0, 8);
        $("#homeProductGrid").innerHTML = productsToShow.length
          ? productsToShow.map(productCard).join("")
          : `<div class="empty" style="grid-column: 1 / -1;">${t("noProducts")}</div>`;
      }
  
      function renderCategoryFilters() {
        $("#categoryFilterChips").innerHTML = categories
          .map((category) => `<a class="chip ${currentCategory === category.slug ? "is-active" : ""}" href="#/${category.slug}">${t(category.key)}</a>`)
          .join("");
      }
  
      function renderCategoryPage() {
        const category = categories.find((item) => item.slug === currentCategory) || categories[0];
        const copy = localize(category);
        $("#categoryTitle").textContent = copy.title;
        $("#categoryText").textContent = copy.text;
        $("#categoryEyebrow").textContent = "AphroditeShop";
        renderCategoryFilters();
        const productsToShow = products.filter((product) => productMatches(product, category.slug, categorySearch));
        $("#categoryProductGrid").innerHTML = productsToShow.length
          ? productsToShow.map(productCard).join("")
          : `<div class="empty" style="grid-column: 1 / -1;">${t("noProducts")}</div>`;
      }
  
      function addToCart(id) {
        const item = cart.find((line) => line.id === id);
        if (item) item.qty += 1;
        else cart.push({ id, qty: 1 });
        saveCart();
        renderCart();
        const product = getProduct(id);
        showToast(t("added", { name: product ? localize(product).name : "" }));
        if (window.matchMedia("(max-width: 720px)").matches) {
          openCart();
        }
      }
  
      function updateQty(id, qty) {
        const product = getProduct(id);
        cart = cart.map((line) => (line.id === id ? { ...line, qty } : line)).filter((line) => line.qty > 0);
        saveCart();
        renderCart();
        if (qty <= 0 && product) showToast(t("removed", { name: localize(product).name }));
      }
  
      function renderCart() {
        const items = cartItems();
        const count = items.reduce((sum, item) => sum + item.qty, 0);
        const totalData = totals();
        $("#cartCount").textContent = count;
        $("#drawerTotal").textContent = formatMad(totalData.total);
        $("#drawerItems").innerHTML = items.length
          ? items.map((item) => {
              const copy = localize(item);
              return `
                <article class="mini-cart-item">
                  <img src="${item.image}" alt="${copy.name}" loading="lazy" />
                  <div>
                    <strong>${copy.name}</strong>
                    <span>${formatMad(item.price)} x ${item.qty}</span>
                    <div style="margin-top:8px;" class="qty">
                      <button type="button" data-qty="${item.id}" data-next="${item.qty - 1}">-</button>
                      <span>${item.qty}</span>
                      <button type="button" data-qty="${item.id}" data-next="${item.qty + 1}">+</button>
                    </div>
                  </div>
                </article>
              `;
            }).join("")
          : `<div class="empty">${t("emptyCart")}</div>`;
  
        renderCheckout();
      }
  
      function renderCheckout() {
        const items = cartItems();
        const totalData = totals();
        $("#checkoutSubtotal").textContent = formatMad(totalData.subtotal);
        $("#checkoutShipping").textContent = totalData.delivery === 0 ? (totalData.subtotal ? t("freeShipping").replace(".", "") : "0 MAD") : formatMad(totalData.delivery);
        $("#checkoutTotal").textContent = formatMad(totalData.total);
        const progress = Math.min(100, Math.round((totalData.subtotal / freeShippingLimit) * 100));
        $("#freeShippingProgress").style.setProperty("--progress", `${progress}%`);
        $("#shippingNote").textContent =
          totalData.subtotal >= freeShippingLimit && totalData.subtotal > 0
            ? t("freeShipping")
            : t("addForFreeShipping", { amount: formatMad(Math.max(0, freeShippingLimit - totalData.subtotal)) });
  
        if (!items.length) {
          $("#checkoutCart").innerHTML = `<div class="empty">${t("emptyCart")}</div>`;
          return;
        }
  
        $("#checkoutCart").innerHTML = `
          <div class="cart-head">
            <span>${t("item")}</span>
            <span>${t("quantity")}</span>
            <span>${t("price")}</span>
            <span></span>
          </div>
          ${items.map((item) => {
            const copy = localize(item);
            return `
              <div class="cart-row">
                <div class="cart-product">
                  <img src="${item.image}" alt="${copy.name}" loading="lazy" />
                  <div>
                    <strong>${copy.name}</strong>
                    <span>${copy.brand}</span>
                  </div>
                </div>
                <div class="qty">
                  <button type="button" data-qty="${item.id}" data-next="${item.qty - 1}">-</button>
                  <span>${item.qty}</span>
                  <button type="button" data-qty="${item.id}" data-next="${item.qty + 1}">+</button>
                </div>
                <strong>${formatMad(item.price * item.qty)}</strong>
                <button class="remove-btn" type="button" data-qty="${item.id}" data-next="0">X</button>
              </div>
            `;
          }).join("")}
        `;
      }
  
      function applyTranslations() {
        document.documentElement.lang = lang;
        document.documentElement.dir = lang === "ar" ? "rtl" : "ltr";
        document.body.dir = lang === "ar" ? "rtl" : "ltr";
        $("[data-i18n-placeholder]") && $$("[data-i18n-placeholder]").forEach((node) => {
          node.placeholder = t(node.dataset.i18nPlaceholder);
        });
        $$("[data-i18n]").forEach((node) => {
          node.textContent = t(node.dataset.i18n);
        });
        $("#languageSelect").value = lang;
        $("#cartButton").setAttribute("aria-label", t("cart"));
        $("#cartButton").setAttribute("title", t("cart"));
        renderNav();
        renderCategories();
        renderFilterChips();
        renderHomeProducts();
        renderCategoryPage();
        renderCart();
        highlightNav();
      }
  
      function resolveTheme(choice) {
        if (choice === "dark" || choice === "light") return choice;
        return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      }
  
      function applyTheme(choice) {
        themeChoice = choice;
        const resolved = resolveTheme(choice);
        document.body.dataset.themeChoice = choice;
        document.body.dataset.resolvedTheme = resolved;
        document.documentElement.style.colorScheme = resolved;
        $$("[data-theme-choice]").forEach((button) => {
          button.classList.toggle("is-active", button.dataset.themeChoice === choice);
        });
      }
  
      function setTheme(choice) {
        localStorage.setItem(themeKey, choice);
        applyTheme(choice);
      }
  
      function showToast(message) {
        clearTimeout(toastTimer);
        $("#toast").textContent = message;
        $("#toast").classList.add("is-visible");
        toastTimer = setTimeout(() => $("#toast").classList.remove("is-visible"), 2400);
      }
  
      function openCart() {
        $("#overlay").classList.add("is-open");
        $("#cartDrawer").classList.add("is-open");
      }
  
      function closeCart() {
        $("#overlay").classList.remove("is-open");
        $("#cartDrawer").classList.remove("is-open");
      }
  
      function route() {
        const slug = (location.hash || "#/").replace("#/", "") || "home";
        const isCheckout = slug === "checkout";
        const category = categories.find((item) => item.slug === slug);
        $("#homePage").classList.toggle("is-active", !isCheckout && !category);
        $("#categoryPage").classList.toggle("is-active", Boolean(category));
        $("#checkoutPage").classList.toggle("is-active", isCheckout);
        if (category) {
          currentCategory = category.slug;
          categorySearch = "";
          $("#categorySearchInput").value = "";
          renderCategoryPage();
        }
        closeCart();
        highlightNav();
        window.scrollTo({ top: 0, behavior: "smooth" });
      }
  
      function highlightNav() {
        const slug = (location.hash || "#/").replace("#/", "") || "home";
        $$("[data-nav]").forEach((link) => {
          link.classList.toggle("is-active", link.dataset.nav === slug);
        });
      }
  
      document.addEventListener("click", (event) => {
        const addButton = event.target.closest("[data-add]");
        if (addButton) {
          addToCart(Number(addButton.dataset.add));
        }
  
        const buyButton = event.target.closest("[data-buy]");
        if (buyButton) {
          addToCart(Number(buyButton.dataset.buy));
          location.hash = "#/checkout";
        }
  
        const filterButton = event.target.closest("[data-filter]");
        if (filterButton) {
          activeFilter = filterButton.dataset.filter;
          renderFilterChips();
          renderHomeProducts();
        }
  
        const qtyButton = event.target.closest("[data-qty]");
        if (qtyButton) {
          updateQty(Number(qtyButton.dataset.qty), Number(qtyButton.dataset.next));
        }
      });
  
      $("#cartButton").addEventListener("click", openCart);
      $("#closeCartButton").addEventListener("click", closeCart);
      $("#overlay").addEventListener("click", closeCart);
      $("#drawerCheckoutButton").addEventListener("click", closeCart);
  
      $("#searchInput").addEventListener("input", (event) => {
        homeSearch = event.target.value;
        renderHomeProducts();
      });
  
      $("#categorySearchInput").addEventListener("input", (event) => {
        categorySearch = event.target.value;
        renderCategoryPage();
      });
  
      $("#languageSelect").addEventListener("change", (event) => {
        lang = event.target.value;
        localStorage.setItem(langKey, lang);
        applyTranslations();
      });
  
      $$("[data-theme-choice]").forEach((button) => {
        button.addEventListener("click", () => setTheme(button.dataset.themeChoice));
      });
  
      $("#checkoutForm").addEventListener("submit", (event) => {
        event.preventDefault();
        if (!cart.length) {
          showToast(t("emptyCart"));
          return;
        }
        cart = [];
        saveCart();
        renderCart();
        event.target.reset();
        showToast(t("orderPlaced"));
        location.hash = "#/";
      });
  
      window.addEventListener("hashchange", route);
      window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", () => {
        if (themeChoice === "auto") applyTheme("auto");
      });
  
      applyTheme(themeChoice);
      applyTranslations();
      route();
    </script>
{% endblock %}
