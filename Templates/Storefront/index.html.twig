{% extends 'base.html.twig' %}

{% block body_attributes %}data-theme-choice="light" data-resolved-theme="light"{% endblock %}

{% block stylesheets %}
  <style>
    :root {
          color-scheme: light;
          --container: min(1180px, calc(100vw - 32px));
          --ease: 0.24s ease;
          --brand: #c6842f;
          --brand-strong: #8f561b;
          --ink: #171717;
          --paper: #fbf7ef;
          --panel: #ffffff;
          --panel-soft: #f3eadc;
          --line: rgba(23, 23, 23, 0.12);
          --line-strong: rgba(23, 23, 23, 0.22);
          --muted: #69645e;
          --good: #16845b;
          --danger: #b13f36;
          --shadow: 0 18px 50px rgba(30, 24, 18, 0.1);
        }
    
        body[data-resolved-theme="dark"] {
          color-scheme: dark;
          --ink: #f7f1e8;
          --paper: #0f1115;
          --panel: #171a20;
          --panel-soft: #20242d;
          --line: rgba(255, 255, 255, 0.1);
          --line-strong: rgba(255, 255, 255, 0.22);
          --muted: #b8b0a6;
          --shadow: 0 18px 55px rgba(0, 0, 0, 0.28);
        }
    
        * {
          box-sizing: border-box;
        }
    
        html {
          scroll-behavior: smooth;
        }
    
        body {
          margin: 0;
          background: var(--paper);
          color: var(--ink);
          font-family: "Space Grotesk", sans-serif;
          transition: background var(--ease), color var(--ease);
        }
    
        body[dir="rtl"] {
          text-align: right;
        }
    
        a {
          color: inherit;
          text-decoration: none;
        }
    
        img {
          display: block;
          max-width: 100%;
        }
    
        button,
        input,
        textarea,
        select {
          font: inherit;
        }
    
        button {
          cursor: pointer;
        }
    
        .topbar {
          background: var(--ink);
          color: var(--paper);
          text-align: center;
          padding: 10px 16px;
          font-size: 0.82rem;
        }
    
        .site-header {
          position: sticky;
          top: 0;
          z-index: 50;
          border-bottom: 1px solid var(--line);
          background: color-mix(in srgb, var(--paper) 88%, transparent);
          backdrop-filter: blur(18px);
        }
    
        .header-inner {
          width: var(--container);
          margin: 0 auto;
          min-height: 74px;
          display: flex;
          align-items: center;
          justify-content: space-between;
          gap: 18px;
        }
    
        .brand {
          display: inline-flex;
          align-items: center;
          gap: 12px;
          font-weight: 700;
          letter-spacing: 0.02em;
          flex-shrink: 0;
        }
    
        .brand-mark {
          width: 38px;
          height: 38px;
          display: grid;
          place-items: center;
          background: var(--brand);
          color: #161616;
          border-radius: 7px;
        }
    
        .nav {
          display: flex;
          align-items: center;
          justify-content: center;
          gap: 18px;
          flex-wrap: wrap;
        }
    
        .nav a {
          color: var(--muted);
          font-size: 0.92rem;
          transition: color var(--ease);
        }
    
        .nav a:hover,
        .nav a.is-active {
          color: var(--brand-strong);
        }
    
        .header-tools {
          display: flex;
          align-items: center;
          justify-content: flex-end;
          gap: 10px;
          flex-shrink: 0;
        }
    
        .segmented,
        .lang-select,
        .icon-btn,
        .button,
        .input {
          border: 1px solid var(--line);
          background: var(--panel);
          color: var(--ink);
          border-radius: 8px;
        }
    
        .segmented {
          display: inline-flex;
          padding: 3px;
          gap: 2px;
        }
    
        .segment-btn {
          border: 0;
          border-radius: 6px;
          background: transparent;
          color: var(--muted);
          min-height: 34px;
          padding: 0 10px;
        }
    
        .segment-btn.is-active {
          background: var(--panel-soft);
          color: var(--ink);
        }
    
        .lang-select {
          min-height: 42px;
          padding: 0 10px;
        }
    
        .icon-btn {
          position: relative;
          min-height: 42px;
          padding: 0 13px;
          display: inline-flex;
          align-items: center;
          gap: 8px;
        }
    
        .cart-icon-btn {
          width: 46px;
          min-width: 46px;
          padding: 0;
          justify-content: center;
        }
    
        .cart-icon {
          width: 22px;
          height: 22px;
          display: block;
        }
    
        .cart-icon-btn .count {
          position: absolute;
          top: -7px;
          right: -7px;
          box-shadow: 0 0 0 2px var(--paper);
        }
    
        body[dir="rtl"] .cart-icon-btn .count {
          right: auto;
          left: -7px;
        }
    
        .sr-only {
          position: absolute;
          width: 1px;
          height: 1px;
          padding: 0;
          margin: -1px;
          overflow: hidden;
          clip: rect(0, 0, 0, 0);
          white-space: nowrap;
          border: 0;
        }
    
        .count {
          min-width: 22px;
          height: 22px;
          display: inline-grid;
          place-items: center;
          border-radius: 999px;
          background: var(--brand);
          color: #171717;
          font-size: 0.78rem;
          font-weight: 700;
        }
    
        .button {
          min-height: 46px;
          padding: 0 18px;
          display: inline-flex;
          align-items: center;
          justify-content: center;
          gap: 8px;
          font-weight: 700;
          transition: transform var(--ease), background var(--ease), color var(--ease);
        }
    
        .button:hover {
          transform: translateY(-1px);
        }
    
        .button.primary {
          border-color: var(--brand);
          background: var(--brand);
          color: #171717;
        }
    
        .button.ghost {
          background: transparent;
        }
    
        .page {
          display: none;
          min-height: calc(100vh - 120px);
        }
    
        .page.is-active {
          display: block;
        }
    
        .hero {
          min-height: min(720px, calc(100vh - 70px));
          display: grid;
          align-items: end;
          background:
            linear-gradient(180deg, rgba(0, 0, 0, 0.1) 0%, rgba(0, 0, 0, 0.62) 100%),
            url("https://images.unsplash.com/photo-1483985988355-763728e1935b?auto=format&fit=crop&w=1800&q=82") center/cover no-repeat;
          color: #fffaf2;
        }
    
        .hero-inner {
          width: var(--container);
          margin: 0 auto;
          padding: 96px 0 58px;
        }
    
        .eyebrow {
          display: inline-flex;
          align-items: center;
          gap: 8px;
          margin-bottom: 12px;
          color: var(--brand);
          font-weight: 700;
          text-transform: uppercase;
          letter-spacing: 0.08em;
          font-size: 0.78rem;
        }
    
        .hero h1,
        .section-head h2,
        .category-hero h1,
        .checkout-head h1 {
          font-family: "Cormorant Garamond", serif;
          font-weight: 600;
          line-height: 0.98;
          margin: 0;
        }
    
        .hero h1 {
          max-width: 760px;
          font-size: clamp(3.2rem, 9vw, 7.2rem);
        }
    
        .hero p {
          max-width: 590px;
          margin: 18px 0 28px;
          color: rgba(255, 250, 242, 0.88);
          line-height: 1.8;
          font-size: 1.06rem;
        }
    
        .hero-actions,
        .toolbar,
        .checkout-actions {
          display: flex;
          gap: 12px;
          flex-wrap: wrap;
          align-items: center;
        }
    
        .section {
          width: var(--container);
          margin: 0 auto;
          padding: 72px 0;
        }
    
        .section-head {
          display: flex;
          align-items: end;
          justify-content: space-between;
          gap: 22px;
          margin-bottom: 26px;
        }
    
        .section-head h2 {
          font-size: clamp(2.2rem, 5vw, 4rem);
          max-width: 760px;
        }
    
        .section-head p {
          max-width: 500px;
          margin: 0;
          color: var(--muted);
          line-height: 1.7;
        }
    
        .category-grid {
          display: grid;
          grid-template-columns: repeat(3, minmax(0, 1fr));
          gap: 16px;
        }
    
        .category-card {
          min-height: 260px;
          display: flex;
          align-items: end;
          justify-content: space-between;
          gap: 18px;
          padding: 22px;
          border-radius: 8px;
          overflow: hidden;
          position: relative;
          color: #fffaf2;
          border: 1px solid rgba(255, 255, 255, 0.18);
          background-size: cover;
          background-position: center;
          box-shadow: var(--shadow);
        }
    
        .category-card::before {
          content: "";
          position: absolute;
          inset: 0;
          background: linear-gradient(180deg, rgba(0, 0, 0, 0.05), rgba(0, 0, 0, 0.72));
        }
    
        .category-card > * {
          position: relative;
        }
    
        .category-card strong {
          display: block;
          font-size: 1.45rem;
          margin-bottom: 6px;
        }
    
        .category-card span {
          display: block;
          color: rgba(255, 250, 242, 0.78);
          line-height: 1.55;
        }
    
        .category-card .button {
          border-color: rgba(255, 255, 255, 0.24);
          color: #fffaf2;
          background: rgba(255, 255, 255, 0.12);
          backdrop-filter: blur(10px);
          flex-shrink: 0;
        }
    
        .toolbar {
          justify-content: space-between;
          margin-bottom: 22px;
        }
    
        .chips {
          display: flex;
          gap: 8px;
          flex-wrap: wrap;
        }
    
        .chip {
          min-height: 40px;
          padding: 0 13px;
          border: 1px solid var(--line);
          border-radius: 8px;
          color: var(--muted);
          background: var(--panel);
        }
    
        .chip.is-active {
          color: var(--ink);
          border-color: var(--brand);
          background: color-mix(in srgb, var(--brand) 14%, var(--panel));
        }
    
        .input {
          min-height: 44px;
          padding: 0 14px;
          outline: none;
        }
    
        .product-grid {
          display: grid;
          grid-template-columns: repeat(4, minmax(0, 1fr));
          gap: 16px;
        }
    
        .product-card {
          background: var(--panel);
          border: 1px solid var(--line);
          border-radius: 8px;
          overflow: hidden;
          box-shadow: var(--shadow);
          display: flex;
          flex-direction: column;
        }
    
        .product-media {
          position: relative;
          aspect-ratio: 4 / 5;
          overflow: hidden;
          background: var(--panel-soft);
        }
    
        .product-media img {
          width: 100%;
          height: 100%;
          object-fit: cover;
          transition: transform 0.35s ease;
        }
    
        .product-card:hover img {
          transform: scale(1.04);
        }
    
        .badge {
          position: absolute;
          top: 12px;
          left: 12px;
          padding: 7px 10px;
          border-radius: 6px;
          background: var(--panel);
          color: var(--ink);
          font-weight: 700;
          font-size: 0.75rem;
        }
    
        body[dir="rtl"] .badge {
          left: auto;
          right: 12px;
        }
    
        .badge.sale {
          background: var(--danger);
          color: #fff;
        }
    
        .product-info {
          padding: 15px;
          display: grid;
          gap: 9px;
          flex: 1;
        }
    
        .product-meta {
          display: flex;
          align-items: center;
          justify-content: space-between;
          gap: 10px;
          color: var(--muted);
          font-size: 0.84rem;
        }
    
        .product-info h3 {
          margin: 0;
          font-size: 1.04rem;
          line-height: 1.35;
        }
    
        .product-info p {
          margin: 0;
          color: var(--muted);
          line-height: 1.55;
          font-size: 0.92rem;
        }
    
        .price-row {
          display: flex;
          align-items: baseline;
          gap: 9px;
          margin-top: auto;
        }
    
        .price {
          font-weight: 700;
          font-size: 1.12rem;
        }
    
        .old-price {
          color: var(--muted);
          text-decoration: line-through;
          font-size: 0.9rem;
        }
    
        .sizes {
          display: flex;
          gap: 6px;
          flex-wrap: wrap;
        }
    
        .size {
          border: 1px solid var(--line);
          color: var(--muted);
          padding: 5px 8px;
          border-radius: 6px;
          font-size: 0.78rem;
        }
    
        .product-actions {
          display: grid;
          grid-template-columns: 1fr 1fr;
          gap: 8px;
        }
    
        .product-actions .button {
          min-height: 42px;
          padding: 0 10px;
        }
    
        .info-band {
          background: var(--ink);
          color: var(--paper);
        }
    
        .info-grid {
          width: var(--container);
          margin: 0 auto;
          padding: 42px 0;
          display: grid;
          grid-template-columns: repeat(4, minmax(0, 1fr));
          gap: 18px;
        }
    
        .info-item strong {
          display: block;
          margin-bottom: 8px;
        }
    
        .info-item p {
          margin: 0;
          color: color-mix(in srgb, var(--paper) 72%, transparent);
          line-height: 1.6;
          font-size: 0.94rem;
        }
    
        .category-hero,
        .checkout-head {
          width: var(--container);
          margin: 0 auto;
          padding: 52px 0 28px;
          display: grid;
          gap: 14px;
        }
    
        .category-hero h1,
        .checkout-head h1 {
          font-size: clamp(2.8rem, 7vw, 5.5rem);
        }
    
        .category-hero p,
        .checkout-head p {
          margin: 0;
          max-width: 700px;
          color: var(--muted);
          line-height: 1.75;
        }
    
        .checkout-layout {
          width: var(--container);
          margin: 0 auto;
          padding: 20px 0 80px;
          display: grid;
          grid-template-columns: minmax(0, 1.25fr) minmax(320px, 0.75fr);
          gap: 22px;
          align-items: start;
        }
    
        .checkout-panel {
          background: var(--panel);
          border: 1px solid var(--line);
          border-radius: 8px;
          box-shadow: var(--shadow);
          overflow: hidden;
        }
    
        .panel-title {
          margin: 0;
          padding: 18px;
          border-bottom: 1px solid var(--line);
          font-size: 1.05rem;
        }
    
        .cart-table {
          display: grid;
        }
    
        .cart-row,
        .cart-head {
          display: grid;
          grid-template-columns: minmax(0, 1.7fr) 120px 120px 44px;
          gap: 14px;
          align-items: center;
          padding: 14px 18px;
          border-bottom: 1px solid var(--line);
        }
    
        .cart-head {
          color: var(--muted);
          font-size: 0.86rem;
          font-weight: 700;
          text-transform: uppercase;
          letter-spacing: 0.04em;
        }
    
        .cart-product {
          display: grid;
          grid-template-columns: 72px 1fr;
          gap: 12px;
          align-items: center;
          min-width: 0;
        }
    
        .cart-product img {
          width: 72px;
          height: 86px;
          object-fit: cover;
          border-radius: 6px;
          background: var(--panel-soft);
        }
    
        .cart-product strong {
          display: block;
          line-height: 1.35;
        }
    
        .cart-product span {
          color: var(--muted);
          font-size: 0.88rem;
        }
    
        .qty {
          width: fit-content;
          display: inline-flex;
          align-items: center;
          border: 1px solid var(--line);
          border-radius: 7px;
          overflow: hidden;
          background: var(--panel);
        }
    
        .qty button {
          width: 34px;
          height: 34px;
          border: 0;
          background: transparent;
          color: var(--ink);
          font-weight: 700;
        }
    
        .qty span {
          min-width: 34px;
          text-align: center;
        }
    
        .remove-btn {
          width: 34px;
          height: 34px;
          border: 1px solid var(--line);
          border-radius: 7px;
          background: transparent;
          color: var(--danger);
          font-weight: 700;
        }
    
        .empty {
          padding: 24px;
          color: var(--muted);
          line-height: 1.7;
        }
    
        .summary {
          padding: 18px;
          display: grid;
          gap: 13px;
        }
    
        .summary-row {
          display: flex;
          justify-content: space-between;
          gap: 12px;
          color: var(--muted);
        }
    
        .summary-row.total {
          color: var(--ink);
          font-weight: 700;
          font-size: 1.13rem;
          padding-top: 12px;
          border-top: 1px solid var(--line);
        }
    
        .progress {
          height: 8px;
          background: var(--panel-soft);
          border-radius: 999px;
          overflow: hidden;
        }
    
        .progress span {
          display: block;
          height: 100%;
          width: var(--progress, 0%);
          background: var(--brand);
        }
    
        .summary-note {
          color: var(--muted);
          line-height: 1.6;
          font-size: 0.92rem;
          margin: 0;
        }
    
        .checkout-form {
          padding: 18px;
          display: grid;
          gap: 13px;
        }
    
        .form-grid {
          display: grid;
          grid-template-columns: 1fr 1fr;
          gap: 13px;
        }
    
        label {
          display: grid;
          gap: 7px;
          color: var(--muted);
          font-size: 0.92rem;
        }
    
        label input,
        label textarea,
        label select {
          min-height: 44px;
          border: 1px solid var(--line);
          border-radius: 8px;
          background: var(--panel);
          color: var(--ink);
          padding: 0 12px;
          outline: none;
        }
    
        label textarea {
          padding: 12px;
          min-height: 108px;
          resize: vertical;
        }
    
        .drawer,
        .overlay {
          position: fixed;
          opacity: 0;
          visibility: hidden;
          transition: opacity var(--ease), transform var(--ease), visibility var(--ease);
        }
    
        .overlay {
          inset: 0;
          z-index: 60;
          background: rgba(0, 0, 0, 0.45);
        }
    
        .overlay.is-open {
          opacity: 1;
          visibility: visible;
        }
    
        .drawer {
          z-index: 70;
          top: 12px;
          right: 12px;
          width: min(410px, calc(100vw - 24px));
          height: calc(100vh - 24px);
          background: var(--panel);
          border: 1px solid var(--line);
          border-radius: 8px;
          box-shadow: var(--shadow);
          transform: translateX(106%);
          display: grid;
          grid-template-rows: auto 1fr auto;
          overflow: hidden;
        }
    
        body[dir="rtl"] .drawer {
          right: auto;
          left: 12px;
          transform: translateX(-106%);
        }
    
        .drawer.is-open {
          opacity: 1;
          visibility: visible;
          transform: translateX(0);
        }
    
        .drawer-head {
          min-height: 64px;
          padding: 0 16px;
          display: flex;
          align-items: center;
          justify-content: space-between;
          border-bottom: 1px solid var(--line);
        }
    
        .drawer-items {
          overflow: auto;
          padding: 14px;
          display: grid;
          align-content: start;
          gap: 12px;
        }
    
        .mini-cart-item {
          display: grid;
          grid-template-columns: 70px 1fr;
          gap: 12px;
          padding: 10px;
          border: 1px solid var(--line);
          border-radius: 8px;
          background: var(--panel-soft);
        }
    
        .mini-cart-item img {
          width: 70px;
          height: 82px;
          object-fit: cover;
          border-radius: 6px;
        }
    
        .mini-cart-item strong {
          display: block;
          line-height: 1.35;
        }
    
        .mini-cart-item span {
          color: var(--muted);
          font-size: 0.9rem;
        }
    
        .drawer-foot {
          padding: 16px;
          display: grid;
          gap: 12px;
          border-top: 1px solid var(--line);
          background: var(--panel);
        }
    
        .toast {
          position: fixed;
          z-index: 90;
          left: 50%;
          bottom: 18px;
          transform: translate(-50%, 16px);
          opacity: 0;
          visibility: hidden;
          background: var(--ink);
          color: var(--paper);
          border-radius: 8px;
          padding: 12px 15px;
          box-shadow: var(--shadow);
          transition: opacity var(--ease), transform var(--ease), visibility var(--ease);
        }
    
        .toast.is-visible {
          opacity: 1;
          visibility: visible;
          transform: translate(-50%, 0);
        }
    
        .footer {
          border-top: 1px solid var(--line);
          background: var(--panel);
        }
    
        .footer-inner {
          width: var(--container);
          margin: 0 auto;
          padding: 40px 0;
          display: grid;
          grid-template-columns: 1.3fr 1fr 1fr 1fr;
          gap: 20px;
          color: var(--muted);
          line-height: 1.7;
        }
    
        .footer h3,
        .footer h4 {
          color: var(--ink);
          margin: 0 0 10px;
        }
    
        .footer a {
          display: block;
          margin: 6px 0;
        }
    
        @media (max-width: 1050px) {
          .header-inner {
            flex-wrap: wrap;
            padding: 12px 0;
          }
    
          .nav {
            order: 3;
            width: 100%;
            justify-content: flex-start;
          }
    
          .category-grid,
          .product-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
          }
    
          .info-grid,
          .checkout-layout,
          .footer-inner {
            grid-template-columns: 1fr 1fr;
          }
        }
    
        @media (max-width: 720px) {
          .header-tools {
            width: 100%;
            justify-content: space-between;
            flex-wrap: wrap;
          }
    
          .hero {
            min-height: 640px;
          }
    
          .section-head,
          .toolbar {
            display: grid;
          }
    
          .category-grid,
          .product-grid,
          .info-grid,
          .checkout-layout,
          .footer-inner,
          .form-grid {
            grid-template-columns: 1fr;
          }
    
          .cart-head {
            display: none;
          }
    
          .cart-row {
            grid-template-columns: 1fr;
            gap: 12px;
          }
    
          .product-actions {
            grid-template-columns: 1fr;
          }
    
          .drawer {
            top: 0;
            right: 0;
            bottom: 0;
            width: 100vw;
            height: 100dvh;
            max-height: 100dvh;
            border-radius: 0;
            border-left: 0;
            border-right: 0;
          }
    
          body[dir="rtl"] .drawer {
            left: 0;
            right: auto;
          }
    
          .drawer-head {
            min-height: 58px;
            padding: 0 14px;
          }
    
          .drawer-items {
            padding: 12px;
            padding-bottom: 18px;
          }
    
          .drawer-foot {
            position: sticky;
            bottom: 0;
            padding: 14px;
          }
    
          .mini-cart-item {
            grid-template-columns: 82px 1fr;
          }
    
          .mini-cart-item img {
            width: 82px;
            height: 96px;
          }
        }
  </style>
{% endblock %}

{% block body %}
  <div class="topbar" data-i18n="topbar">Livraison offerte des 599 MAD | Retours sous 10 jours | Paiement securise bientot disponible</div>
  
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="#/">
          <span class="brand-mark">AS</span>
          <span>AphroditeShop</span>
        </a>
  
        <nav class="nav" id="mainNav" aria-label="Navigation principale"></nav>
  
        <div class="header-tools">
          <div class="segmented" aria-label="Theme">
            <button class="segment-btn" type="button" data-theme-choice="light" data-i18n="themeLight">Clair</button>
            <button class="segment-btn" type="button" data-theme-choice="dark" data-i18n="themeDark">Sombre</button>
            <button class="segment-btn" type="button" data-theme-choice="auto" data-i18n="themeAuto">Auto</button>
          </div>
  
          <select class="lang-select" id="languageSelect" aria-label="Language">
            <option value="fr">FR</option>
            <option value="en">EN</option>
            <option value="ar">AR</option>
          </select>
  
          <button class="icon-btn cart-icon-btn" id="cartButton" type="button" aria-label="Panier" title="Panier">
            <span class="sr-only" data-i18n="cart">Panier</span>
            <svg class="cart-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="8" cy="21" r="1"></circle>
              <circle cx="19" cy="21" r="1"></circle>
              <path d="M2.05 2.05h2l2.7 12.6a2 2 0 0 0 2 1.6h8.9a2 2 0 0 0 2-1.6l1.6-8.4H5.12"></path>
            </svg>
            <span class="count" id="cartCount">0</span>
          </button>
        </div>
      </div>
    </header>
  
    <main>
      <section class="page is-active" id="homePage">
        <div class="hero">
          <div class="hero-inner">
            <span class="eyebrow" data-i18n="heroEyebrow">Nouvelle collection</span>
            <h1 data-i18n="heroTitle">Mode urbaine, sneakers et parfums selectionnes.</h1>
            <p data-i18n="heroText">
              Decouvrez les pieces qui donnent du caractere a votre dressing: looks homme et femme, accessoires, parfums et sneakers prets a commander.
            </p>
            <div class="hero-actions">
              <a class="button primary" href="#/new-in" data-i18n="heroCta">Voir les nouveautes</a>
              <a class="button ghost" href="#/checkout" data-i18n="checkout">Checkout</a>
            </div>
          </div>
        </div>
  
        <section class="section">
          <div class="section-head">
            <div>
              <span class="eyebrow" data-i18n="categoriesEyebrow">Boutique</span>
              <h2 data-i18n="categoriesTitle">Explorez chaque univers.</h2>
            </div>
            <p data-i18n="categoriesText">
              Chaque categorie a maintenant sa propre page, avec une selection adaptee et un parcours plus clair.
            </p>
          </div>
          <div class="category-grid" id="categoryGrid"></div>
        </section>
  
        <section class="section">
          <div class="section-head">
            <div>
              <span class="eyebrow" data-i18n="featuredEyebrow">Selection</span>
              <h2 data-i18n="featuredTitle">Les pieces a ne pas manquer.</h2>
            </div>
            <p data-i18n="featuredText">Un mix de basiques premium, de sneakers et de finitions qui completent le look.</p>
          </div>
  
          <div class="toolbar">
            <div class="chips" id="filterChips"></div>
            <input class="input" id="searchInput" type="search" data-i18n-placeholder="searchPlaceholder" placeholder="Rechercher un produit..." />
          </div>
  
          <div class="product-grid" id="homeProductGrid"></div>
        </section>
  
        <section class="info-band">
          <div class="info-grid">
            <div class="info-item">
              <strong data-i18n="infoDeliveryTitle">Livraison rapide</strong>
              <p data-i18n="infoDeliveryText">Expedition preparee rapidement avec suivi et confirmation de commande.</p>
            </div>
            <div class="info-item">
              <strong data-i18n="infoReturnsTitle">Retours faciles</strong>
              <p data-i18n="infoReturnsText">Retour ou echange sous 10 jours selon l'etat du produit.</p>
            </div>
            <div class="info-item">
              <strong data-i18n="infoPaymentTitle">Paiement flexible</strong>
              <p data-i18n="infoPaymentText">Plusieurs methodes de paiement pourront etre ajoutees au checkout.</p>
            </div>
            <div class="info-item">
              <strong data-i18n="infoThemeTitle">Theme au choix</strong>
              <p data-i18n="infoThemeText">Mode clair par defaut, avec theme sombre et mode automatique disponibles.</p>
            </div>
          </div>
        </section>
      </section>
  
      <section class="page" id="categoryPage">
        <div class="category-hero">
          <span class="eyebrow" id="categoryEyebrow">AphroditeShop</span>
          <h1 id="categoryTitle"></h1>
          <p id="categoryText"></p>
        </div>
        <section class="section" style="padding-top: 22px;">
          <div class="toolbar">
            <div class="chips" id="categoryFilterChips"></div>
            <input class="input" id="categorySearchInput" type="search" data-i18n-placeholder="searchPlaceholder" placeholder="Rechercher un produit..." />
          </div>
          <div class="product-grid" id="categoryProductGrid"></div>
        </section>
      </section>
  
      <section class="page" id="checkoutPage">
        <div class="checkout-head">
          <span class="eyebrow" data-i18n="checkoutEyebrow">Votre commande</span>
          <h1 data-i18n="checkoutTitle">Panier et checkout.</h1>
          <p data-i18n="checkoutText">Verifiez vos articles, choisissez votre mode de paiement et renseignez les informations de livraison.</p>
        </div>
  
        <div class="checkout-layout">
          <section class="checkout-panel">
            <h2 class="panel-title" data-i18n="cartDetails">Articles du panier</h2>
            <div class="cart-table" id="checkoutCart"></div>
          </section>
  
          <aside class="checkout-panel">
            <h2 class="panel-title" data-i18n="summary">Resume</h2>
            <div class="summary">
              <div class="summary-row">
                <span data-i18n="subtotal">Sous-total</span>
                <strong id="checkoutSubtotal">0 MAD</strong>
              </div>
              <div class="summary-row">
                <span data-i18n="delivery">Livraison</span>
                <strong id="checkoutShipping">0 MAD</strong>
              </div>
              <div class="summary-row total">
                <span data-i18n="total">Total</span>
                <strong id="checkoutTotal">0 MAD</strong>
              </div>
              <div class="progress" aria-hidden="true"><span id="freeShippingProgress"></span></div>
              <p class="summary-note" id="shippingNote"></p>
              <div class="checkout-actions">
                <a class="button ghost" href="#/" data-i18n="continueShopping">Continuer mes achats</a>
              </div>
            </div>
          </aside>
  
          <section class="checkout-panel">
            <h2 class="panel-title" data-i18n="deliveryInfo">Informations de livraison</h2>
            <form class="checkout-form" id="checkoutForm">
              <div class="form-grid">
                <label>
                  <span data-i18n="fullName">Nom complet</span>
                  <input name="name" required placeholder="Sara El Amrani" />
                </label>
                <label>
                  <span data-i18n="phone">Telephone</span>
                  <input name="phone" required placeholder="+212 6XX XX XX XX" />
                </label>
              </div>
              <div class="form-grid">
                <label>
                  <span data-i18n="city">Ville</span>
                  <input name="city" required placeholder="Casablanca" />
                </label>
                <label>
                  <span data-i18n="district">Quartier</span>
                  <input name="district" required placeholder="Maarif" />
                </label>
              </div>
              <label>
                <span data-i18n="address">Adresse complete</span>
                <textarea name="address" required placeholder="Rue, immeuble, etage, point de repere..."></textarea>
              </label>
              <label>
                <span data-i18n="paymentMethod">Mode de paiement</span>
                <select name="payment">
                  <option value="delivery" data-i18n="payDelivery">Paiement a la livraison</option>
                  <option value="card" disabled data-i18n="payCardSoon">Carte bancaire - bientot</option>
                </select>
              </label>
              <button class="button primary" type="submit" data-i18n="placeOrder">Valider la commande</button>
            </form>
          </section>
  
          <aside class="checkout-panel">
            <h2 class="panel-title" data-i18n="checkoutHelpTitle">Besoin d'aide ?</h2>
            <div class="summary">
              <p class="summary-note" data-i18n="checkoutHelpText">
                Notre equipe peut confirmer les tailles, la disponibilite et les delais avant l'expedition.
              </p>
              <a class="button ghost" href="tel:+212600000000">+212 600 000 000</a>
              <a class="button ghost" href="mailto:hello@aphroditeshop.ma">hello@aphroditeshop.ma</a>
            </div>
          </aside>
        </div>
      </section>
    </main>
  
    <div class="overlay" id="overlay"></div>
  
    <aside class="drawer" id="cartDrawer" aria-label="Panier">
      <div class="drawer-head">
        <strong data-i18n="cart">Panier</strong>
        <button class="icon-btn" id="closeCartButton" type="button" aria-label="Close">X</button>
      </div>
      <div class="drawer-items" id="drawerItems"></div>
      <div class="drawer-foot">
        <div class="summary-row total">
          <span data-i18n="total">Total</span>
          <strong id="drawerTotal">0 MAD</strong>
        </div>
        <a class="button primary" href="#/checkout" id="drawerCheckoutButton" data-i18n="checkout">Checkout</a>
      </div>
    </aside>
  
    <footer class="footer">
      <div class="footer-inner">
        <div>
