{% extends 'base.html.twig' %}

{% block title %}{{ title }} | AphroditeShop{% endblock %}

{% block body_attributes %}data-theme-choice="light" data-resolved-theme="light"{% endblock %}

{% block stylesheets %}
  <link rel="stylesheet" href="{{ asset('styles/storefront.css') }}">
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script type="module" src="{{ asset('storefront.js') }}"></script>
{% endblock %}

{% block body %}
  <script type="application/json" data-storefront-config>
    {{ {
      cartKey: 'aphroditeshop-cart-v3',
      themeKey: 'aphroditeshop-theme-v3',
      checkoutUrl: path('storefront_checkout'),
      cartAddUrl: path('cart_add'),
      cartMergeUrl: path('cart_merge'),
      cartRemoveUrl: path('cart_remove'),
      cartCsrfToken: csrf_token('cart'),
      orderCreateUrl: path('checkout_order_create'),
      orderCsrfToken: csrf_token('checkout_order'),
      isAuthenticated: app.user ? true : false,
      accountCart: authenticatedCart,
      freeShippingLimit: 599,
      shippingCost: 29
    }|json_encode|raw }}
  </script>

  {% include 'Storefront/partials/_header.html.twig' %}

  <main>
    {% if page == 'home' %}
      {% include 'Storefront/partials/_home.html.twig' %}
    {% elseif page != 'product' %}
      {% include 'Storefront/partials/_page_head.html.twig' %}
    {% endif %}

    {% if page != 'product' and subcategories is not empty %}
      {% include 'Storefront/partials/_subcategories.html.twig' %}
    {% endif %}

    {% if page == 'product' and product %}
      {% include 'Storefront/partials/_product_detail.html.twig' %}
    {% elseif page != 'checkout' %}
      {% include 'Storefront/partials/_product_grid.html.twig' with {
        products: products,
        topPadding: subcategories is not empty ? '12px' : '52px'
      } %}
    {% else %}
      {% include 'Storefront/partials/_checkout.html.twig' %}
    {% endif %}
  </main>

  {% include 'Storefront/partials/_footer.html.twig' %}
  {% include 'Storefront/partials/_cart_drawer.html.twig' %}
{% endblock %}
